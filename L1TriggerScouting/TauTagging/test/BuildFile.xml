<bin file="alpaka/test.dev.cc testRunner.cc" name="testTauTagging">
  <use name="alpaka"/>
  <use name="boost_filesystem"/>
  <use name="cppunit"/>
  <use name="HeterogeneousCore/AlpakaInterface"/>
  <use name="sofieblas"/>
  <use name="sofie"/>
  <use name="openblas" for="alpaka/serial"/>
  <use name="cuda-cublas" for="alpaka/cuda"/>
  <use name="hipblas" for="alpaka/rocm"/>
  <use name="hipblas-common" for="alpaka/rocm"/>
  <use name="hipblaslt" for="alpaka/rocm"/>
  <!-- host-side compilation of hipblas* 7.14 headers violates -Werror;
       sofieBLAS_blaslt_common.tpp:168 ignores a nodiscard hipError_t in device code.
       Demote those diagnostics for this test (proper fix belongs in sofieBLAS) -->
  <flags CXXFLAGS="-Wno-error=strict-aliasing -Wno-unused-but-set-variable" for="alpaka/rocm"/>
  <flags ROCM_FLAGS="-Wno-error=unused-value" for="alpaka/rocm"/>
  <flags ALPAKA_BACKENDS="1"/>
</bin>
